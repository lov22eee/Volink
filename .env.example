# Copy to .env, then fill every empty value (or run ./scripts/setup-env.sh). Never commit .env.
MYSQL_DATABASE=volink
MYSQL_USER=volink
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
SERVER_PORT=8080
# Base64 of 32+ random bytes. Signs login tokens. Required for any shared/deployed server.
JWT_SECRET=
# Local/demo environment only: password for the demo login accounts ({code}@demo.volink.kr).
DEMO_ACCOUNT_PASSWORD=
# Kakao and AWS credentials are not needed until weeks 4 and 7.
